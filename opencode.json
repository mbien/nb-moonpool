{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "lathe": {
                "type": "local",
                "command": ["sh", ".lathe/lathe-mcp-launcher.sh"],
                "cwd": ".",
                "environment": {
                    "LATHE_JVM_OPTS": "-Dlathe.cache=.m2/lathe-cache"
                },
                "timeout": {
                    "startup": 60000,
                    "catalog": 30000,
                    "execution": 300000
                }
            }
        }
    }
}
